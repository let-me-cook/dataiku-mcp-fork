# Your Dataiku DSS instance URL, including the port if needed (HTTPS by default).
DSS_HOST=

# Your Dataiku DSS API key. Quote the value if it contains # or spaces.
DSS_API_KEY=

# Opt in only for a trusted HTTP-only network; HTTP sends the key without encryption.
DSS_ALLOW_HTTP=false

# Set to automation on an automation node to refuse tools that edit projects.
DSS_INSTANCE_TYPE=design

# Opt in to clear and delete tools.
DSS_ALLOW_DESTRUCTIVE=false

# Optional external intake adapter. Its tools stay hidden until DSS_INTAKE_URL is set, so leave it unset until a backend implements INTAKE-API.md.
# DSS_INTAKE_URL=https://intake.example/api/
# DSS_INTAKE_TOKEN=
# DSS_INTAKE_PROJECTS=MY_PROJECT
# DSS_INTAKE_ALLOW_HTTP=false
